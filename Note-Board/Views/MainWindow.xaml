<Window x:Class="Note_Board.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Note_Board.Views"
        mc:Ignorable="d"
        Title="Note Board"
        WindowState="Maximized"
        ResizeMode="CanResize"
        MinWidth="800" MinHeight="600"
        Background="#7D848B">

    <Border BorderBrush="#7D492E" BorderThickness="10" Margin="20" Height="Auto">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Canvas Background="#FFFFFF" Height="1000" Width="1900">
                <local:Cardholder Canvas.Left="10" Canvas.Top="10" />
                <local:Dustbin Canvas.Left="10" Canvas.Top="150" />
            </Canvas>
        </ScrollViewer>
    </Border>
</Window>
